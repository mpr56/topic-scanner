# Database: SQLite locally, Neon/Supabase Postgres in production (postgres:// URLs are accepted)
DATABASE_URL=sqlite:///./scanner.db
# Groq API key (console.groq.com)
GROQ_API_KEY=
# Model used to draft segment definitions (rare, quality matters)
GROQ_MODEL_ANALYZE=openai/gpt-oss-120b
# Model used for batch grouping/scoring (frequent, cost matters)
GROQ_MODEL_SCORE=openai/gpt-oss-20b
# Bearer token for scripts / CLI access to the API
API_TOKEN=
# Password for the UI login (empty disables login)
APP_PASSWORD=
# Secret used to sign session cookies
SESSION_SECRET=dev-insecure-change-me
# Origin allowed by CORS (the UI dev server)
UI_ORIGIN=http://localhost:5173
# Set false for local http development
COOKIE_SECURE=true
# Max Groq tokens one run-due invocation may spend across all segments
RUN_TOKEN_BUDGET=20000
# "inline" runs scans inside the API request (local); "github" dispatches the Actions workflow (prod)
RUN_NOW_MODE=inline
# GitHub token with Actions: write, repo as owner/name, and the branch to dispatch on (github mode only)
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_REF=main
# Optional Reddit app credentials, if Reddit blocks unauthenticated requests from cloud IPs
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# User-Agent sent to every source
USER_AGENT=topic-scanner/0.1
